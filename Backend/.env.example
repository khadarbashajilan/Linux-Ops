OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Filesystem scope.
#
# Implicit (cannot be removed):
#   read:    ~ + cwd (server working directory)
#   write:   cwd + /tmp
#   exec:    cwd
#
# Hard-deny (cannot be removed; additive via LINUXOPS_DENIED_PATHS):
#   ~/.ssh, ~/.aws, ~/.gnupg, ~/.config/gh, ~/.config/git-credential-manager,
#   /etc, /boot, /sys, /proc, .env*
#
# LINUXOPS_ALLOWED_PATHS adds extra read+write+exec scopes on top of the
# implicit defaults. Entries are :/,/-separated; ~ is expanded.
# LINUXOPS_DENIED_PATHS adds extra hard-denied paths.
LINUXOPS_ALLOWED_PATHS=
LINUXOPS_DENIED_PATHS=